# Crie um projeto em https://supabase.com e cole as chaves abaixo.
# O app não conecta a nada até você preencher isto e renomear para .env.local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Senha da área administrativa de overalls (server-side).
# Se não definir, o projeto usa 0707 apenas como fallback local.
ADMIN_PASSWORD=troque-esta-senha

# Chave secreta usada APENAS pelo servidor para salvar overalls no Supabase.
SUPABASE_SERVICE_ROLE_KEY=
